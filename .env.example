# Django core
SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,your-service-name.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://your-service-name.onrender.com
SECURE_SSL_REDIRECT=True

# Database (dev default)
# sqlite: sqlite:///db.sqlite3
# postgres example: postgresql://user:password@localhost:5432/cwms
DATABASE_URL=postgresql://user:password@host:5432/cwms

# Optional cache (leave blank to use Django DummyCache)
REDIS_URL=

# Optional one-time bootstrap admin on first deploy
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
